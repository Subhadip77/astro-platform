# ===================================================
# ASTRO PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control!

# --- Server / General ---
NODE_ENV=development
PORT=5000

# --- Frontend Client ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# --- Database (MySQL 8 - utf8mb4_unicode_ci) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=astro_platform
DB_USER=astro_user
DB_PASSWORD=your_mysql_password
DB_CONNECTION_LIMIT=10

# --- Cache (Redis) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL_SECONDS=86400

# --- Authentication (JWT) ---
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# --- Sensitive Data Encryption ---
# 32-byte key for AES-256-GCM encryption of sensitive birth details
DATA_ENCRYPTION_KEY=your_32_byte_hex_or_base64_encryption_key

# --- AstrologyAPI (External Provider) ---
# Calculations come from AstrologyAPI. Only the astro service layer may call this.
ASTROLOGY_API_USER_ID=your_astrology_api_user_id
ASTROLOGY_API_API_KEY=your_astrology_api_key
ASTROLOGY_API_BASE_URL=https://json.astrologyapi.com/v1

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --- Email (SendGrid) ---
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=no-reply@astroplatform.com
SENDGRID_FROM_NAME="Astro Platform"
